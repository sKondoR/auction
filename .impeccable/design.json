  "narrative": {
    "northStar": "Лавка при дневном свете",
    "overview": "Антикварная лавка с распахнутыми окнами: бутылочно-зелёная вывеска, латунь, шрифт старой русской книги и линейные иконки, но светлый прилавок и ровный дневной свет. Два регистра: многослойная пастельная витрина (главная, категории, баннеры) и плоский плотный прилавок (поиск, лот, ставки, кабинет, админка). Эталон витрины — принятый концепт «Сургучное поле» (frontend-ideas/07).",
    "keyCharacteristics": [
      "Светлый фон, вещи на фотоколодце",
      "Зелёный — единственный цвет действия",
      "Сургуч — только срочность торгов и закрытый список исключений",
      "Пастели — отделы-категории",
      "Old Standard TT для заголовков, Golos Text для рабочего",
      "Многослойность только в витрине"
    ],
    "rules": [
      {
        "name": "Правило одного голоса",
        "body": "Зелёный — единственный цвет действия; единственное неинтерактивное применение — итоговая сумма расчёта, одна на блок.",
        "section": "colors"
      },
      {
        "name": "Правило сургуча",
        "body": "Красный — только время или событие торгов; одно красное хиро на страницу. Закрытый список исключений: сердце «в избранном», точка логотипа, ошибки форм.",
        "section": "colors"
      },
      {
        "name": "Правило прилавка",
        "body": "Фото лота на прилавке всегда лежит на фотоколодце, не на пастели.",
        "section": "colors"
      },
      {
        "name": "Правило двух голосов",
        "body": "Серифом говорит площадка, гротеском — торги.",
        "section": "typography"
      },
      {
        "name": "Правило табличных цифр",
        "body": "Цены, ставки и таймеры набираются табличными цифрами.",
        "section": "typography"
      },
      {
        "name": "Правило плоского прилавка",
        "body": "На экранах торгов нет теней в покое.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do держать фон страницы #FBFAF6, а фото лотов — на фотоколодце #F3F1EB; карточка лота своего фона не имеет",
      "Do отдавать зелёному #1D3B2A каждое главное действие и только его",
      "Do закреплять за категорией одну пастель и один линейный рисунок",
      "Do строить главную по полиритму H → S → R → C → E → T → R → D → P",
      "Do набирать цены, ставки и таймеры Golos Text с табличными цифрами",
      "Do дублировать красный цвет срочности иконкой или словом",
      "Do подписывать примерные лоты, цены и ставки на витрине и давать паузу живому демо",
      "Do тонировать тень под цвет поля, на котором лежит слой"
    ],
    "donts": [
      "Don't ставить красный вне срочности и событий торгов, кроме закрытого списка исключений",
      "Don't класть фото лота на пастель на страницах прилавка",
      "Don't набирать названия лотов, цены и таймеры серифом",
      "Don't смешивать стили иконок",
      "Don't выдумывать статистику, отзывы и логотипы партнёров",
      "Don't использовать тени в покое на рабочих экранах",
      "Don't ставить прописные «брови» над заголовками секций и хиро"
    ]
  }
}
