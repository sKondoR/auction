{
  "name": "auction",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @auction/web --filter @auction/worker dev",
    "dev:web": "pnpm --filter @auction/web dev",
    "dev:worker": "pnpm --filter @auction/worker dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @auction/db generate",
    "db:migrate": "pnpm --filter @auction/db migrate",
    "db:seed": "pnpm --filter @auction/db seed",
    "db:studio": "pnpm --filter @auction/db studio",
    "setup": "pnpm infra:up && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
