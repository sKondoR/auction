# --- Локальная разработка (docker compose) ---
DATABASE_URL=postgres://auction:auction@localhost:5433/auction
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=change-me-local-dev-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# S3 (MinIO локально, Yandex Object Storage в облаке)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central1
S3_BUCKET=auction
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/auction

# SMS: console | smsru
SMS_PROVIDER=console

# Email (Mailpit локально: веб-интерфейс http://localhost:8025)
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Аукцион <no-reply@auction.local>"
